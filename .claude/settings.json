{
  "$comment": "这个文件定义共享给仓库协作者的 Claude Code 项目级设置，默认面向已配置完成的 Ubuntu ai-infra 环境。",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(rg *)",
      "Bash(python -m pip install -e .*)",
      "Bash(python3 -m pip install -e .*)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python benchmarks/benchmark_*)",
      "Bash(python3 benchmarks/benchmark_*)",
      "Bash(nvidia-smi)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./weights/**)",
      "Read(./checkpoints/**)"
    ]
  }
}
